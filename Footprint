		private void DisposeBrushes()
		{
			if (upBrushDX != null) { upBrushDX.Dispose(); upBrushDX = null; }
		    if (downBrushDX != null) { downBrushDX.Dispose(); downBrushDX = null; }
			if (upBrushDX1 != null) { upBrushDX1.Dispose(); upBrushDX1 = null; }
		    if (downBrushDX1 != null) { downBrushDX1.Dispose(); downBrushDX1 = null; }
		    if (buyImbalanceBrushDX != null) { buyImbalanceBrushDX.Dispose(); buyImbalanceBrushDX = null; }
		    if (sellImbalanceBrushDX != null) { sellImbalanceBrushDX.Dispose(); sellImbalanceBrushDX = null; }
		    if (neutralBrushDX != null) { neutralBrushDX.Dispose(); neutralBrushDX = null; }
		    if (neutralBrushDX1 != null) { neutralBrushDX1.Dispose(); neutralBrushDX1 = null; }
			if (deltaBrushDX != null) { deltaBrushDX.Dispose(); deltaBrushDX = null; }
			if (dxTransparent != null) { dxTransparent.Dispose(); dxTransparent  = null; }
		}
		
