		{
			DisposeBrushes();
			if (RenderTarget != null)
    		{
				if (upBrushDX == null)
			    	upBrushDX = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color(50, 205, 50, 128)); // green
			
				if (downBrushDX == null)
				    downBrushDX = new SharpDX.Direct2D1.SolidColorBrush(RenderTarget, new SharpDX.Color(138, 43, 226, 128)); // red
				
				if (upBrushDX1 == null)
