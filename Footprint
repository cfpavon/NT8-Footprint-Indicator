		protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
			
			if (barBins == null || barBins.Count == 0) return;
			
			

			if (upBrushDX == null || downBrushDX == null || upBrushDX1 == null || downBrushDX1 == null ||
				buyImbalanceBrushDX == null || sellImbalanceBrushDX == null ||
				neutralBrushDX == null || neutralBrushDX1 == null || deltaBrushDX == null || dxTransparent == null) return;
			
			
			
			
			foreach (var kvp in barBins)
			{
			    int barIndex = kvp.Key;
				
				
				
				// Only render if this bar has closed
		        //if (!closedBars.Contains(barIndex))
		        //    continue;
			    //float xBase = chartControl.GetXByBarIndex(ChartBars, barIndex) + CandleSpacing;
				//float xBase = chartControl.GetXByBarIndex(ChartBars, barIndex) + (float)chartControl.BarWidth+ CandleSpacing;
				double candleWidth = chartControl.BarWidth;
				float xBase0 = chartControl.GetXByBarIndex(ChartBars, barIndex) - (float)candleWidth / 2f+chartControl.Properties.BarDistance-10f;
				//float xBase = chartControl.GetXByBarIndex(ChartBars, barIndex) - (float)candleWidth / 2f-10f;
				float xBase = xBase0-25f;
				float xBase2 = xBase0+((float)chartControl.BarWidth)+10f;
				
				//float xBase0 = chartControl.GetXByBarIndex(ChartBars, barIndex)+ (float)chartControl.BarWidth+ CandleSpacing-10;
				//float xBase = chartControl.GetXByBarIndex(ChartBars, barIndex)+ (float)chartControl.BarWidth+ CandleSpacing;
				
				//float xBase2 = chartControl.GetXByBarIndex(ChartBars, barIndex)+ (float)chartControl.BarWidth+ CandleSpacing+RectWidth+2;
				
				var keys = kvp.Value.Keys.ToList();
				keys.Sort();
				double minPrice = keys.First() - BinSize / 2.0;
				double maxPrice = keys.Last() + BinSize / 2.0;
				
				imbalanceLevelsBuy = new Dictionary<double, string>();
				imbalanceLevelsSell = new Dictionary<double, string>();
				
				for (int j = 0; j < keys.Count - 1; j++)
				{
				    double currentPrice = keys[j];
				    double nextPrice    = keys[j + 1];
				
				    double askVolCurrent   = kvp.Value[nextPrice].ask;
				    double bidVolAbove     = kvp.Value[currentPrice].bid;
				
				    // ✅ Buy imbalance: ask at current vs bid above
				    if (askVolCurrent >= 3 * bidVolAbove )
				    {
				        imbalanceLevelsSell[nextPrice] = "Sell"; // store at ASK level below
				    }
				
				    // ✅ Sell imbalance: bid above vs ask current
				    else if (bidVolAbove >= 3 * askVolCurrent )
				    {
				        
						imbalanceLevelsBuy[currentPrice] = "Buy"; // store at BID level above
				    }
				}
			
			    int i = 0;
				double totalBid = 0;
				double totalAsk = 0;
				double totalDelta = 0;
				
				double maxKey = double.NaN;
				double maxVol = 0;
				
				float yMin = chartScale.GetYByValue(minPrice);
				float yMax = chartScale.GetYByValue(maxPrice);
				float span = yMin - yMax; // vertical pixel span
				
				
				var levels = kvp.Value.Select(kvp1 => new { Price = kvp1.Key, Vol = kvp1.Value.vol,AcVol = kvp1.Value.ask-kvp1.Value.bid  })
                 .OrderBy(x => x.Price)
                 .ToList();
				double totalVol = levels.Sum(l => l.Vol);
				
				double totalActiveVol = levels.Sum(x => x.AcVol);
				
				double VolRatio=totalActiveVol/totalVol*100;
				
				double cumulative = 0;
				var cumLevels = new List<(double Price, double CumPct)>();
				
				foreach (var l in levels)
				{
				    cumulative += l.Vol;
				    double pct = cumulative / totalVol;
				    cumLevels.Add((l.Price, pct));
				}
				
				double VAH = cumLevels.First(l => l.CumPct >= 0.80).Price;
				double VAL = cumLevels.First(l => l.CumPct >= 0.20).Price;

				
				
				
				
					
				int binCount = keys.Count;
				int rectHeight = (int) span / binCount;
				// Clamp between min and max
				int rectWeight  = Math.Max(25, Math.Min((int)(chartControl.Properties.BarDistance*0.5f), 30));
				//int rectWeight = (int)(chartControl.BarWidth*0.65);
					
				float baseSize = (float)(chartControl.Properties.BarDistance)*0.3f; // 5% of window width

				// Clamp between min and max
				float fontSize = Math.Max(10f, Math.Min(baseSize, 11f));
				
				float fontSize2 = Math.Max(12f, Math.Min(baseSize, 13f));
				
				textFormat = new SharpDX.DirectWrite.TextFormat(
	            factoryDW,
	            "Arial",
	            SharpDX.DirectWrite.FontWeight.Normal,      // bold
	            SharpDX.DirectWrite.FontStyle.Normal,
	            SharpDX.DirectWrite.FontStretch.Normal,
	            fontSize                                      // font size
		        )
		        {
		            TextAlignment = SharpDX.DirectWrite.TextAlignment.Center,   // right align
		            ParagraphAlignment = SharpDX.DirectWrite.ParagraphAlignment.Near // vertical centering
		        };
				
				textFormat2 = new SharpDX.DirectWrite.TextFormat(
	            factoryDW,
	            "Arial",
	            SharpDX.DirectWrite.FontWeight.Bold,      // bold
	            SharpDX.DirectWrite.FontStyle.Normal,
	            SharpDX.DirectWrite.FontStretch.Normal,
	            fontSize2                                      // font size
		        )
		        {
		            TextAlignment = SharpDX.DirectWrite.TextAlignment.Center,   // right align
		            ParagraphAlignment = SharpDX.DirectWrite.ParagraphAlignment.Near // vertical centering
		        };
				
			    foreach (var bin in kvp.Value)
			    {
					
					double price = bin.Key;
			        double bidVol = bin.Value.bid;
			        double askVol = bin.Value.ask;
			        double delta = askVol - bidVol;
					double volRatio=((askVol-bidVol)/bin.Value.vol)*100;
					
					//Print("Percentage Vol:  "+volRatio.ToString("F2"));
					totalBid += bidVol;
					totalAsk += askVol;
					totalDelta+=delta;
					
					if (bin.Value.vol >= maxVol)
				    {
				        maxVol = bin.Value.vol;
				        maxKey = bin.Key;
				    }
					
					
					
					
					
					
					
					
					
					
					
					
					bool hasImbalanceBuy = imbalanceLevelsBuy.ContainsKey(price);
					bool hasImbalanceSell = imbalanceLevelsSell.ContainsKey(price);;
					
					
					
					
			
			        float yCenter = chartScale.GetYByValue(price);
					float yTop    = yCenter - RectHeight / 2f;
			
					
					var rect0 = new SharpDX.RectangleF(xBase, yTop, rectWeight*3, rectHeight);
					
					RenderTarget.DrawRectangle(rect0, delta>50?upBrushDX:(delta<-50?downBrushDX:dxTransparent));
			        // Fixed rectangle
			        var rect = new SharpDX.RectangleF(xBase, yTop, rectWeight, rectHeight);
			
			        // Fill color by delta
			        var brush = delta > 0 ? upBrushDX : (delta < 0 ? downBrushDX : neutralBrushDX);
					
					var brushTxt = hasImbalanceBuy ? buyImbalanceBrushDX: neutralBrushDX;
					var brushTxt1 = hasImbalanceSell ? sellImbalanceBrushDX: neutralBrushDX;
					
					
					var downBrushFill = hasImbalanceBuy ? downBrushDX: dxTransparent;
					var upBrushFill = hasImbalanceSell ? upBrushDX: dxTransparent;
					
			        RenderTarget.FillRectangle(rect, downBrushFill);
					
					
			
			        // Draw text (delta value)
			        var layout = new SharpDX.DirectWrite.TextLayout(
			            factoryDW,
			            askVol.ToString("F0"),
			            textFormat,
			            rectWeight,
			            rectHeight);
			
			        RenderTarget.DrawTextLayout(
			            new SharpDX.Vector2(xBase2, yTop),
			            layout,
			            brushTxt);
					
					var rect1 = new SharpDX.RectangleF(xBase2, yTop, rectWeight, rectHeight);
					
					RenderTarget.FillRectangle(rect1, upBrushFill);
					
					// Draw text (delta value)
			        var layout1 = new SharpDX.DirectWrite.TextLayout(
			            factoryDW,
			            bidVol.ToString("F0"),
			            textFormat,
			            rectWeight,
			            rectHeight);
			
			        RenderTarget.DrawTextLayout(
			            new SharpDX.Vector2(xBase, yTop),
			            layout1,
			            brushTxt1);
			        
			        i++;
			    }
				
				
				float yPrice = chartScale.GetYByValue(minPrice- BinSize / 2.0);
				float yPrice1 = chartScale.GetYByValue(minPrice- 3*(BinSize / 2.0));
				float yPriceVol = chartScale.GetYByValue(minPrice- 5*(BinSize / 2.0));
				float yPrice2 = chartScale.GetYByValue(maxKey+ BinSize / 2.0);
				
				float yVAH = chartScale.GetYByValue(VAH+ BinSize / 2.0);
				float yVAL = chartScale.GetYByValue(VAL- BinSize / 2.0);
				
				// Draw text (delta value)
		        var layout2 = new SharpDX.DirectWrite.TextLayout(
		            factoryDW,
		            totalAsk.ToString("F0"),
		            textFormat2,
		            rectWeight,
		            rectHeight);
		
		        RenderTarget.DrawTextLayout(
		            new SharpDX.Vector2(xBase2, yPrice),
		            layout2,
		            deltaBrushDX);
				
				// Draw text (delta value)
		        var layout3 = new SharpDX.DirectWrite.TextLayout(
		            factoryDW,
		            totalBid.ToString("F0"),
		            textFormat2,
		            rectWeight,
		            rectHeight);
		
		        RenderTarget.DrawTextLayout(
		            new SharpDX.Vector2(xBase, yPrice),
		            layout3,
		            deltaBrushDX);
				
				// Draw text (delta value)
		        var layout4 = new SharpDX.DirectWrite.TextLayout(
		            factoryDW,
		            totalDelta.ToString("F0"),
		            textFormat2,
		            2*rectWeight,
		            rectHeight);
		
		        RenderTarget.DrawTextLayout(
		            new SharpDX.Vector2(xBase, yPrice1),
		            layout4,
		            totalDelta > 0 ? upBrushDX1 : (totalDelta < 0 ? downBrushDX1 : neutralBrushDX));
				
				
				var layout5 = new SharpDX.DirectWrite.TextLayout(
		            factoryDW,
		            VolRatio.ToString("F1"),
		            textFormat2,
		            2*rectWeight,
		            rectHeight);
		
		        RenderTarget.DrawTextLayout(
		            new SharpDX.Vector2(xBase, yPriceVol),
		            layout5,
		            neutralBrushDX);
				
				
				var rect3 = new SharpDX.RectangleF(xBase0, yPrice2, 7f, 5f);
					
				RenderTarget.FillRectangle(rect3, deltaBrushDX);
				
				
				var rect4 = new SharpDX.RectangleF(xBase0, yVAH, 7f, 5f);
					
				RenderTarget.FillRectangle(rect4, neutralBrushDX);
				
				var rect5 = new SharpDX.RectangleF(xBase0, yVAL, 7f, 5f);
					
				RenderTarget.FillRectangle(rect5, neutralBrushDX);
				
			
				
				
			}

		}
		
